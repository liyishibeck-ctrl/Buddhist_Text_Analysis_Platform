APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/buddha_corpus
ENABLE_AUTO_SEED=false
SAMPLE_CORPUS_PATH=
HAN_CATALOG_SOURCE_PATH=
HAN_CATALOG_BUNDLE_PATH=
HAN_CORE_TEXT_SOURCE_PATH=
HAN_CORE_TEXT_BUNDLE_PATH=
HAN_CBETA_MANIFEST_PATH=
SQL_ECHO=false
PGVECTOR_SCHEMA_HINT=public
EMBEDDING_PROVIDER=local-hash
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSION=64
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30

# Aliyun/mainland deploy example:
# Point these URLs at an OpenAI-compatible gateway that your server can reach.
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSION=2048
# EMBEDDING_API_URL=https://your-gateway.example.com/v1/embeddings
# LLM_API_URL=https://your-gateway.example.com/v1/responses
# OPENAI_API_KEY=sk-...

# The OpenAI Batch workflow reuses the same API URL / key / model settings.
# For large uploads or downloads, consider increasing the timeout.

# Optional per-tradition overrides. Example suffixes:
# - trad-pali    -> EMBEDDING_API_KEY_TRAD_PALI
# - trad-tibetan -> EMBEDDING_API_KEY_TRAD_TIBETAN
#
# EMBEDDING_PROVIDER_TRAD_PALI=
# EMBEDDING_MODEL_TRAD_PALI=
# EMBEDDING_DIMENSION_TRAD_PALI=
# EMBEDDING_API_URL_TRAD_PALI=
# EMBEDDING_API_KEY_TRAD_PALI=
#
# EMBEDDING_PROVIDER_TRAD_TIBETAN=
# EMBEDDING_MODEL_TRAD_TIBETAN=
# EMBEDDING_DIMENSION_TRAD_TIBETAN=
# EMBEDDING_API_URL_TRAD_TIBETAN=
# EMBEDDING_API_KEY_TRAD_TIBETAN=

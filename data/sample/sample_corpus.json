    {
      "id": "seg-xj-001",
      "text_version_id": "tv-xinjing-xuanzang",
      "structural_unit_id": "su-xj-01",
      "segment_key": "XJ.1",
      "title": "色空不二",
      "content": "色不异空，空不异色；受想行识，亦复如是。",
      "content_gloss": "Form and emptiness are inseparable; the same applies to the aggregates.",
      "normalized_content": "色不异空 空不异色 受想行识 亦复如是",
      "note": "sample/mock paraphrase",
      "position": 1,
      "char_count": 22,
      "metadata_json": { "is_mock_excerpt": true, "section": "emptiness" }
    },
    {
      "id": "seg-xj-002",
      "text_version_id": "tv-xinjing-xuanzang",
      "structural_unit_id": "su-xj-01",
      "segment_key": "XJ.2",
      "title": "诸法无著",
      "content": "无眼耳鼻舌身意，无色声香味触法；以此显诸法不可执著。",
      "content_gloss": "The senses and their objects are denied to loosen attachment to fixed dharmas.",
      "normalized_content": "无眼耳鼻舌身意 无色声香味触法 诸法不可执著",
      "note": "sample/mock paraphrase",
      "position": 2,
      "char_count": 29,
      "metadata_json": { "is_mock_excerpt": true, "section": "non-attachment" }
    },
    {
      "id": "seg-xj-003",
      "text_version_id": "tv-xinjing-xuanzang",
      "structural_unit_id": "su-xj-02",
      "segment_key": "XJ.3",
      "title": "心无罣碍",
      "content": "依般若波罗蜜多，心无罣碍，故无有恐怖，远离颠倒梦想。",
      "content_gloss": "Reliance on prajna removes obstruction and fear.",
      "normalized_content": "依般若波罗蜜多 心无罣碍 故无有恐怖 远离颠倒梦想",
      "note": "sample/mock paraphrase",
      "position": 3,
      "char_count": 30,
      "metadata_json": { "is_mock_excerpt": true, "section": "liberation" }
    },
    {
      "id": "seg-jg-001",
      "text_version_id": "tv-jingangjing-kumarajiva",
      "structural_unit_id": "su-jg-01",
      "segment_key": "JG.1",
      "title": "诸相非相",
      "content": "凡所有相，皆是虚妄；若见诸相非相，即见如来。",
      "content_gloss": "All marks are deceptive; seeing non-mark as such is seeing the Tathagata.",
      "normalized_content": "凡所有相 皆是虚妄 若见诸相非相 即见如来",
      "note": "sample/mock paraphrase",
      "position": 1,
      "char_count": 24,
      "metadata_json": { "is_mock_excerpt": true, "section": "marks" }
    },
    {
      "id": "seg-jg-002",
      "text_version_id": "tv-jingangjing-kumarajiva",
      "structural_unit_id": "su-jg-02",
      "segment_key": "JG.2",
      "title": "应无所住",
      "content": "应无所住而生其心，发心而不滞于色声等境。",
      "content_gloss": "Generate resolve without abiding in sensory objects.",
      "normalized_content": "应无所住而生其心 发心而不滞于色声等境",
      "note": "sample/mock paraphrase",
      "position": 2,
      "char_count": 23,
      "metadata_json": { "is_mock_excerpt": true, "section": "non-abiding" }
    },
    {
      "id": "seg-jg-003",
      "text_version_id": "tv-jingangjing-kumarajiva",
      "structural_unit_id": "su-jg-02",
      "segment_key": "JG.3",
      "title": "离相求见",
      "content": "若以色见我，以音声求我，是人行邪道，不能见如来。",
      "content_gloss": "Seeking awakening through visible or audible signs misleads.",
      "normalized_content": "若以色见我 以音声求我 是人行邪道 不能见如来",
      "note": "sample/mock paraphrase",
      "position": 3,
      "char_count": 27,
      "metadata_json": { "is_mock_excerpt": true, "section": "misdirected-seeking" }
    },
    {

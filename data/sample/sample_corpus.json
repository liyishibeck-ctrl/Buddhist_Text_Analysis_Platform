      "structural_unit_id": "su-dc-02",
      "segment_key": "DC.2",
      "title": "Four noble truths",
      "content": "Idam dukkham ariyasaccam; ayam dukkhasamudayo; ayam dukkhanirodho; ayam dukkhanirodhagamina patipada.",
      "content_gloss": "The discourse frames suffering, its arising, cessation, and the path.",
      "normalized_content": "idam dukkham ariyasaccam ayam dukkhasamudayo ayam dukkhanirodho ayam dukkhanirodhagamina patipada",
      "note": "sample/mock condensed passage",
      "position": 2,
      "char_count": 118,
      "metadata_json": { "is_mock_excerpt": true, "section": "four-noble-truths" }
    },

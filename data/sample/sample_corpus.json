      "text_version_id": "tv-anatta-cst4",
      "structural_unit_id": "su-an-01",
      "segment_key": "AN.2",
      "title": "Aggregates are not self",
      "content": "Vedana anatta, sanna anatta, sankhara anatta, vinnanam anatta.",
      "content_gloss": "Feeling, perception, formations, and consciousness are likewise not self.",
      "normalized_content": "vedana anatta sanna anatta sankhara anatta vinnanam anatta",
      "note": "sample/mock condensed passage",
      "position": 2,
      "char_count": 71,
      "metadata_json": { "is_mock_excerpt": true, "section": "aggregates" }
    },
    {
      "id": "seg-an-003",
      "text_version_id": "tv-anatta-cst4",
      "structural_unit_id": "su-an-02",
      "segment_key": "AN.3",
      "title": "Impermanent, suffering, not self",
      "content": "Yam aniccam tam dukkham; yam dukkham tadanatta; evam passato nibbindati virajjati vimuccati.",
      "content_gloss": "What is impermanent is suffering; what is suffering is not self; through seeing this one is released.",
      "normalized_content": "yam aniccam tam dukkham yam dukkham tadanatta evam passato nibbindati virajjati vimuccati",
      "note": "sample/mock condensed passage",
      "position": 3,
      "char_count": 106,
      "metadata_json": { "is_mock_excerpt": true, "section": "release" }
    },

      "id": "seg-dc-003",
      "text_version_id": "tv-dhammacakkappavattana-cst4",
      "structural_unit_id": "su-dc-02",
      "segment_key": "DC.3",
      "title": "Vision arises",
      "content": "Yam kinci samudayadhammam sabbam tam nirodhadhammam; dhammacakkhum udapadi.",
      "content_gloss": "Insight arises that what has a nature of arising also ceases.",
      "normalized_content": "yam kinci samudayadhammam sabbam tam nirodhadhammam dhammacakkhum udapadi",
      "note": "sample/mock condensed passage",
      "position": 3,
      "char_count": 83,
      "metadata_json": { "is_mock_excerpt": true, "section": "insight" }
    },
    {

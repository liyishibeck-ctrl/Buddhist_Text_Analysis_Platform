      "structural_unit_id": "su-an-01",
      "segment_key": "AN.1",
      "title": "Form is not self",
      "content": "Rupam bhikkhave anatta; yadanatta tam n'etam mama n'eso ham asmi na me so atta.",
      "content_gloss": "Form is not self and should not be grasped as mine or me.",
      "normalized_content": "rupam bhikkhave anatta yadanatta tam netam mama neso ham asmi na me so atta",
      "note": "sample/mock condensed passage",
      "position": 1,
      "char_count": 89,
      "metadata_json": { "is_mock_excerpt": true, "section": "non-self" }
    },
    {

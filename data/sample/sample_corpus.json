      "text_version_id": "tv-metta-cst4",
      "structural_unit_id": "su-me-01",
      "segment_key": "ME.1",
      "title": "Kusalena",
      "content": "Karaniyam attha kusalena: sakko uju ca suhuju ca, suvaco cassa mudu anatimani.",
      "content_gloss": "One cultivating the good should be capable, upright, gentle, and humble.",
      "normalized_content": "karaniyam attha kusalena sakko uju ca suhuju ca suvaco cassa mudu anatimani",
      "note": "sample/mock condensed passage",
      "position": 1,
      "char_count": 92,
      "metadata_json": { "is_mock_excerpt": true, "section": "ethics" }
    },
    {
      "id": "seg-me-002",
      "text_version_id": "tv-metta-cst4",
      "structural_unit_id": "su-me-02",
      "segment_key": "ME.2",
      "title": "Mother and child",
      "content": "Mata yatha niyam puttam ayusa eka puttam anurakkhe, evampi sabbabhutesu mettam bhavaye aparimanam.",
      "content_gloss": "Like a mother guarding her only child, one should cultivate boundless loving-kindness.",
      "normalized_content": "mata yatha niyam puttam ayusa eka puttam anurakkhe evampi sabbabhutesu mettam bhavaye aparimanam",
      "note": "sample/mock condensed passage",
      "position": 2,
      "char_count": 116,
      "metadata_json": { "is_mock_excerpt": true, "section": "loving-kindness" }
    },
    {
      "id": "seg-me-003",
      "text_version_id": "tv-metta-cst4",
      "structural_unit_id": "su-me-02",
      "segment_key": "ME.3",
      "title": "Boundless mind",
      "content": "Mettan ca sabbalokasmin manasam bhavaye aparimanam uddham adho ca tiriyanca.",
      "content_gloss": "One should cultivate an immeasurable mind of friendliness in every direction.",
      "normalized_content": "mettan ca sabbalokasmin manasam bhavaye aparimanam uddham adho ca tiriyanca",
      "note": "sample/mock condensed passage",
      "position": 3,
      "char_count": 88,
      "metadata_json": { "is_mock_excerpt": true, "section": "boundlessness" }
    },

      "segments": [
        {
          "segment_key": "T0251-1",
          "position": 1,
          "title": "观自在照见五蕴",
          "structural_unit_id": "hsu-root",
          "content": "观自在菩萨在深观中照见五蕴皆空，提醒修行者先松开对身心经验的执著，再回到般若智慧本身。",
          "content_gloss": "Avalokitesvara sees the five aggregates as empty, and practice begins by loosening attachment to experience.",
          "note": "Pilot paraphrase for retrieval and concept indexing."
        },
        {
          "segment_key": "T0251-2",
          "position": 2,
          "title": "色空不二",
          "structural_unit_id": "hsu-root",
          "content": "色与空并不对立；若执著于形相，就会把缘起中的流动经验误认成固定实体，因此不应住相。",
          "content_gloss": "Form and emptiness are not opposed; clinging to appearances mistakes dependent experience for fixed essence.",
          "note": "Core emptiness passage condensed for pilot use."
        },
        {
          "segment_key": "T0251-3",
          "position": 3,
          "title": "无怖畏安住",
          "structural_unit_id": "hsu-root",
          "content": "当心不再被相绑住，修行就从恐惧里松脱出来，转而以智慧安住，形成可用于检索的稳定 doctrinal anchor.",
          "content_gloss": "When the mind is not bound by appearances, fear softens and wisdom becomes the place of rest.",
          "note": "Closing pilot segment for the Heart Sutra."
        }
      ],

      ],
      "segments": [
        {
          "segment_key": "T0235-1",
          "position": 1,
          "title": "无住行施",
          "structural_unit_id": "dsu-root",
          "content": "修行和布施都不应依附于可见的相；若心里不断抓取结果，善行就会被自我中心重新包裹。",
          "content_gloss": "Giving and practice should not cling to appearances; grasping outcomes wraps virtue back into self-centeredness.",
          "note": "Pilot paraphrase for the Diamond Sutra."
        },
        {
          "segment_key": "T0235-2",
          "position": 2,
          "title": "离四相",
          "structural_unit_id": "dsu-root",
          "content": "若仍执我相、人相、众生相、寿者相，就还在概念里转圈；离相不是否认世界，而是不再把它固化成实体。",
          "content_gloss": "Clinging to self, person, beings, and lifespan keeps thought circling within concepts instead of releasing them.",
          "note": "High-value doctrinal anchor for retrieval and comparison."
        },
        {
          "segment_key": "T0235-3",
          "position": 3,
          "title": "功德不住",
          "structural_unit_id": "dsu-root",
          "content": "行善、持经、传法都应随缘回向，而不住于功德之名；这种不住功德的表达是后续对照检索的关键锚点。",
          "content_gloss": "Virtue is directed and shared without abiding in the name of merit; this becomes a key comparison anchor.",
          "note": "Closing pilot segment for the Diamond Sutra."
        }
      ],

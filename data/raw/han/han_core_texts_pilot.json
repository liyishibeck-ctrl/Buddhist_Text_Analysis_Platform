      "segments": [
        {
          "segment_key": "T1509-1",
          "position": 1,
          "title": "般若为母",
          "structural_unit_id": "dlu-root",
          "content": "般若被描述为诸佛之母，因为智慧不是附属解释，而是破除执著、开启理解的根本力量。",
          "content_gloss": "Prajna is described as the mother of buddhas because wisdom is the root force that opens understanding.",
          "note": "Core scholastic anchor for later retrieval."
        },
        {
          "segment_key": "T1509-2",
          "position": 2,
          "title": "空与缘起",
          "structural_unit_id": "dlu-root",
          "content": "空并不是虚无，而是不把任何法当成固定实体；因此空义与缘起必须一起读，才能避免落入断常两边。",
          "content_gloss": "Emptiness is not nothingness; it prevents any dharma from becoming a fixed essence and must be read together with dependent arising.",
          "note": "This segment is a strong match candidate for other prajna texts."
        },
        {
          "segment_key": "T1509-3",
          "position": 3,
          "title": "随机设教",
          "structural_unit_id": "dlu-root",
          "content": "论书强调方法要跟随众生根器而变化：先破执，再立行；先解缚，再说明何以可行。",
          "content_gloss": "The treatise stresses adapting method to capacity: first break attachment, then establish practice.",
          "note": "Closing pilot segment for the Dazhidu Lun."
        }
      ],
